{
    "version": "v0.0.1",
    "description": "Aria2 超·懒人包，将 aria2-next 注册为 Windows系统服务，附带AriaNg、trackers更新脚本",
    "homepage": "https://github.com/Nahuimi/Aria2-SuperLazyPackage",
    "license": "GPL-2.0",
    "notes": [
        "⚠️ 硬性要求：管理员PowerShell + 必须加 --global 安装",
        "⚠️ scoop update 更新后，务必再次执行 install.bat 修复服务路径：& $dir\\install.bat",
        "⚠️ 配置建议：直接前往 persist 目录修改 aria2.conf，不要修改程序目录内文件",
        "管理：Aria2-Explorer插件，或执行 start $dir/AriaNg/index.html 打开面板",
        "更新Tracker：终端输入 renew-trackers，完成后重启 Aria2Service",
        "卸载：管理员执行 scoop uninstall aria2-superlazy --global"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nahuimi/Aria2-SuperLazyPackage/releases/download/v0.0.1/Aria2-SuperLazyPackage.zip",
            "hash": "e77e4cc75a0af3d590d4a2cbf88b842adbc4a1e484e839428e06daf604fd425a",
            "extract_dir": "Aria2"
        }
    },
    "bin": [
        "aria2c.exe",
        "shawl.exe",
        ["RenewTrackers.ps1", "renew-trackers"],
        ["AriaNg/index.html", "ariang", "Start-Process"]
    ],
    "persist": [
        "aria2.conf",
        "aria2.session",
        "aria2.log",
        "dht.dat",
        "dht6.dat"
    ],
    "pre_install": [
        "if (-not $global) { throw '❌必须添加 --global 参数安装'}",
        "# 校验管理员权限",
        "$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "if (-not $isAdmin) { throw '❌请以【管理员身份】运行PowerShell再执行安装' }"
    ],
    "post_install": [
        "Start-Process -FilePath \"$dir\\install.bat\" -Wait -NoNewWindow"
    ],
    "pre_uninstall": [
        "Start-Process -FilePath \"$dir\\uninstall.bat\" -Wait -NoNewWindow"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Nahuimi/Aria2-SuperLazyPackage/releases/download/$version/Aria2-SuperLazyPackage.zip"
            }
        }
    }
}
